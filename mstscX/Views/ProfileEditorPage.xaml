                        <CheckBox IsChecked="{Binding RemoteAppUseRdWeb, Mode=TwoWay}" SemanticProperties.Description="RD Web" />
                        <Label Text="RD Web" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding RemoteAppUseRdWeb}" Spacing="6">
                        <Label Text="{loc:Text Key=SE11CBDF5A755}" Style="{StaticResource FieldTitle}" />
                        <Entry TextChanged="OnEditorFieldChanged" Text="{Binding RemoteAppFeedAddress}" Placeholder="https://server.example.com/RDWeb/Feed/webfeed.aspx"
                               SemanticProperties.Description="{loc:Text Key=SE11CBDF5A755}" />
                        <Label Text="{loc:Text Key=S2924C891B437}" FontSize="12"
                               TextColor="{AppThemeBinding Light=#344763, Dark=#AAC2E2}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowGateway}" Spacing="6">
                    <Label Text="{loc:Text Key=S4ACD15403415}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{loc:Text Key=S3E47013888B4}" Style="{StaticResource FieldTitle}" />
                    <Picker ItemsSource="{Binding GatewayUsageMethods}" SelectedIndex="{Binding GatewayUsageMethod, Mode=TwoWay}"
                            SemanticProperties.Description="{loc:Text Key=S3E47013888B4}" />
                    <VerticalStackLayout IsVisible="{Binding ShowGatewayFields}" Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding GatewayUseExplicitProfile, Mode=TwoWay}"
                                      SemanticProperties.Description="{loc:Text Key=SDB6E47698893}" />
                            <Label Text="{loc:Text Key=SDB6E47698893}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{loc:Text Key=SA2B2970ADA54}" Style="{StaticResource FieldTitle}" />
                        <Entry Text="{Binding GatewayHostName, Mode=TwoWay}" Placeholder="rdgateway.example.com"
                               SemanticProperties.Description="{loc:Text Key=SA2B2970ADA54}" />
                        <Label Text="{loc:Text Key=S6676352F6D43}" Style="{StaticResource FieldTitle}" />
