<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:winui="clr-namespace:mstscX.WinUI"
             xmlns:vm="clr-namespace:mstscX.ViewModels"
             x:Class="mstscX.Views.ProfileEditorPage"
             x:DataType="vm:MainViewModel">
    <ContentPage.Resources>
        <Style x:Key="EditorPanel" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#CFDDF1, Dark=#35455E}" />
        </Style>
        <Style x:Key="SectionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#192C49, Dark=#E7EFFC}" />
            <Setter Property="Padding" Value="38,8,8,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="PathButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DFE9F7, Dark=#263750}" />
        </Style>
    </ContentPage.Resources>
    <Grid ColumnDefinitions="184,*" ColumnSpacing="0" IsEnabled="{Binding CanEdit}">
        <Border Style="{StaticResource EditorPanel}" Padding="10,12"
                BackgroundColor="{AppThemeBinding Light=#EAF0FA, Dark=#182234}">
            <VerticalStackLayout Spacing="5">
                <Grid>
                    <Button Text="Общие" Style="{StaticResource SectionButton}"
                            HandlerChanged="OnSectionButtonHandlerChanged" Command="{Binding SelectEditorTabCommand}" CommandParameter="0">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowGeneral}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D8E8FF, Dark=#29446E}" />
                        </DataTrigger></Button.Triggers>
                    </Button>
                    <Image Style="{StaticResource SectionIcon}" Source="{AppThemeBinding Light={winui:InterfaceImage Name=nav_settings_light}, Dark={winui:InterfaceImage Name=nav_settings_dark}}" />
                </Grid>
                <Grid>
                    <Button Text="Экран" Style="{StaticResource SectionButton}"
                            HandlerChanged="OnSectionButtonHandlerChanged" Command="{Binding SelectEditorTabCommand}" CommandParameter="1">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowDisplay}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D8E8FF, Dark=#29446E}" />
                        </DataTrigger></Button.Triggers>
                    </Button>
                    <Image Style="{StaticResource SectionIcon}" Source="{AppThemeBinding Light={winui:InterfaceImage Name=nav_display_light}, Dark={winui:InterfaceImage Name=nav_display_dark}}" />
                </Grid>
                <Grid>
                    <Button Text="Локальные ресурсы" Style="{StaticResource SectionButton}"
                            HandlerChanged="OnSectionButtonHandlerChanged" Command="{Binding SelectEditorTabCommand}" CommandParameter="2">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowResources}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D8E8FF, Dark=#29446E}" />
                        </DataTrigger></Button.Triggers>
                    </Button>
                    <Image Style="{StaticResource SectionIcon}" Source="{AppThemeBinding Light={winui:InterfaceImage Name=nav_resources_light}, Dark={winui:InterfaceImage Name=nav_resources_dark}}" />
                </Grid>
                <Grid>
                    <Button Text="RemoteApp" Style="{StaticResource SectionButton}"
                            HandlerChanged="OnSectionButtonHandlerChanged" Command="{Binding SelectEditorTabCommand}" CommandParameter="3">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowRemoteApp}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D8E8FF, Dark=#29446E}" />
                        </DataTrigger></Button.Triggers>
                    </Button>
                    <Image Style="{StaticResource SectionIcon}" Source="{AppThemeBinding Light={winui:InterfaceImage Name=nav_remote_app_light}, Dark={winui:InterfaceImage Name=nav_remote_app_dark}}" />
                </Grid>
                <Grid>
                    <Button Text="Шлюз RD" Style="{StaticResource SectionButton}"
                            HandlerChanged="OnSectionButtonHandlerChanged" Command="{Binding SelectEditorTabCommand}" CommandParameter="4">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowGateway}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D8E8FF, Dark=#29446E}" />
                        </DataTrigger></Button.Triggers>
                    </Button>
                    <Image Style="{StaticResource SectionIcon}" Source="{AppThemeBinding Light={winui:InterfaceImage Name=nav_gateway_light}, Dark={winui:InterfaceImage Name=nav_gateway_dark}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource EditorPanel}"
                BackgroundColor="{AppThemeBinding Light=#F8FAFD, Dark=#141B25}">
            <Grid RowDefinitions="*,Auto">
                <ScrollView Padding="20,16">
                    <VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowGeneral}" Spacing="6">
                    <Label Text="Общие" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Наименование" Style="{StaticResource FieldTitle}" />
                    <Entry TextChanged="OnEditorFieldChanged" Text="{Binding ProfileName}" SemanticProperties.Description="Наименование" />
                    <Label Text="{Binding ProfileNameError}" TextColor="{AppThemeBinding Light=#A4262C, Dark=#FF9B9B}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ProfileNameError}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Адрес подключения" Style="{StaticResource FieldTitle}" />
                    <Entry TextChanged="OnEditorFieldChanged" Text="{Binding ProfileAddress}" Placeholder="server.example.com" SemanticProperties.Description="Адрес подключения" />
                    <Label Text="Логин" Style="{StaticResource FieldTitle}" />
                    <Entry TextChanged="OnEditorFieldChanged" Text="{Binding ProfileUserName}" Placeholder="DOMAIN\user" SemanticProperties.Description="Логин" />
                    <Label Text="Пароль" Style="{StaticResource FieldTitle}" />
                    <Entry TextChanged="OnEditorFieldChanged" Text="{Binding ProfilePassword}" IsPassword="True" SemanticProperties.Description="Пароль" />
                    <VerticalStackLayout IsVisible="{Binding HasSavedPassword}">
                        <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding RemovePassword, Mode=TwoWay}" SemanticProperties.Description="Удалить сохранённый пароль" /><Label Text="Удалить сохранённый пароль" VerticalOptions="Center" /></HorizontalStackLayout>
                        <Label Text="Пароль сохранён. Оставьте поле пустым, чтобы сохранить его." />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding TrustProfile, Mode=TwoWay}" SemanticProperties.Description="Доверять этому серверу" /><Label Text="Доверять этому серверу" VerticalOptions="Center" /></HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowDisplay}" Spacing="6">
                    <Label Text="Экран" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.Triggers>
                            <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding RemoteAppEnabled}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </HorizontalStackLayout.Triggers>
                        <CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding OpenInSeparateWindow, Mode=TwoWay}"
                                  SemanticProperties.Description="В отдельном окне" />
                        <Label Text="В отдельном окне" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Разрешение удалённого рабочего стола" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" Title="Разрешение" SelectedIndex="{Binding Display.Resolution, Mode=TwoWay}"><Picker.Items><x:String>По размеру окна</x:String><x:String>1024 × 768</x:String><x:String>1280 × 720</x:String><x:String>1600 × 900</x:String><x:String>1920 × 1080</x:String><x:String>2560 × 1440</x:String></Picker.Items></Picker>
                    <Label Text="Глубина цвета" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" Title="Цвета" SelectedIndex="{Binding Display.Colors, Mode=TwoWay}"><Picker.Items><x:String>32 бита</x:String><x:String>24 бита</x:String><x:String>16 бит</x:String><x:String>15 бит</x:String></Picker.Items></Picker>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.FullScreen, Mode=TwoWay}" SemanticProperties.Description="Подключаться в полноэкранном режиме" /><Label Text="Подключаться в полноэкранном режиме" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.Triggers><DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding RemoteAppEnabled}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger></HorizontalStackLayout.Triggers>
                        <CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.UseMultimon, Mode=TwoWay}"
                                  SemanticProperties.Description="Использовать все мониторы в полноэкранном режиме" />
                        <Label Text="Использовать все мониторы в полноэкранном режиме" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Производительность" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" SelectedIndex="{Binding Display.ConnectionType, Mode=TwoWay}"
                            SemanticProperties.Description="Тип подключения">
                        <Picker.Items>
                            <x:String>По умолчанию</x:String><x:String>Модем</x:String><x:String>Медленный широкополосный канал</x:String>
                            <x:String>Спутниковое соединение</x:String><x:String>Быстрый широкополосный канал</x:String>
                            <x:String>Глобальная сеть</x:String><x:String>Локальная сеть</x:String><x:String>Определять автоматически</x:String>
                        </Picker.Items>
                    </Picker>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.DisableWallpaper, Mode=TwoWay}" SemanticProperties.Description="Скрывать обои" /><Label Text="Скрывать обои" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.DisableFullWindowDrag, Mode=TwoWay}" SemanticProperties.Description="Показывать только контур при перетаскивании окон" /><Label Text="Показывать только контур при перетаскивании окон" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.DisableMenuAnimations, Mode=TwoWay}" SemanticProperties.Description="Отключить анимацию меню" /><Label Text="Отключить анимацию меню" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.FontSmoothing, Mode=TwoWay}" SemanticProperties.Description="Сглаживать шрифты" /><Label Text="Сглаживать шрифты" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Display.VideoPlayback, Mode=TwoWay}" SemanticProperties.Description="Оптимизировать воспроизведение видео" /><Label Text="Оптимизировать воспроизведение видео" VerticalOptions="Center" /></HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowResources}" Spacing="6">
                    <Label Text="Локальные ресурсы" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Воспроизведение звука" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" Title="Звук" SelectedIndex="{Binding Resources.AudioPlayback, Mode=TwoWay}"><Picker.Items><x:String>На этом компьютере</x:String><x:String>На удалённом компьютере</x:String><x:String>Не воспроизводить</x:String></Picker.Items></Picker>
                    <Label Text="Качество звука" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" SelectedIndex="{Binding Resources.AudioQuality, Mode=TwoWay}"
                            SemanticProperties.Description="Качество звука">
                        <Picker.Items><x:String>Автоматически</x:String><x:String>Среднее (со сжатием)</x:String><x:String>Высокое (без сжатия)</x:String></Picker.Items>
                    </Picker>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.AudioRecording, Mode=TwoWay}" SemanticProperties.Description="Запись звука с этого компьютера" /><Label Text="Запись звука с этого компьютера" VerticalOptions="Center" /></HorizontalStackLayout>
                    <Label Text="Сочетания клавиш Windows" Style="{StaticResource FieldTitle}" />
                    <Picker SelectedIndexChanged="OnEditorFieldChanged" Title="Клавиатура" SelectedIndex="{Binding Resources.Keyboard, Mode=TwoWay}"><Picker.Items><x:String>На этом компьютере</x:String><x:String>На удалённом компьютере</x:String><x:String>Только в полноэкранном режиме</x:String></Picker.Items></Picker>
                    <Label Text="Локальные устройства и ресурсы" Style="{StaticResource FieldTitle}" />
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.Printers, Mode=TwoWay}" SemanticProperties.Description="Принтеры" /><Label Text="Принтеры" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.Clipboard, Mode=TwoWay}" SemanticProperties.Description="Буфер обмена" /><Label Text="Буфер обмена" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.Drives, Mode=TwoWay}" SemanticProperties.Description="Диски" /><Label Text="Диски" VerticalOptions="Center" /></HorizontalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding Resources.Drives}" Margin="24,0,0,0" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding RedirectAllDrives, Mode=TwoWay}" SemanticProperties.Description="Все диски" />
                            <Label Text="Все диски" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding RedirectAllDrives}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger></VerticalStackLayout.Triggers>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DriveChoices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RdpDriveChoice">
                                        <HorizontalStackLayout Spacing="6">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" SemanticProperties.Description="{Binding Name}" />
                                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding RedirectNewDrives, Mode=TwoWay}" SemanticProperties.Description="Диски, подключённые во время сеанса" />
                                <Label Text="Диски, подключённые во время сеанса" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.Ports, Mode=TwoWay}" SemanticProperties.Description="Порты" /><Label Text="Порты" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.SmartCards, Mode=TwoWay}" SemanticProperties.Description="Смарт-карты" /><Label Text="Смарт-карты" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.Devices, Mode=TwoWay}" SemanticProperties.Description="Поддерживаемые устройства Plug and Play" /><Label Text="Поддерживаемые устройства Plug and Play" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding Resources.PointOfSaleDevices, Mode=TwoWay}" SemanticProperties.Description="Устройства POS" /><Label Text="Устройства POS" VerticalOptions="Center" /></HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowRemoteApp}" Spacing="6">
                    <Label Text="RemoteApp" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox CheckedChanged="OnEditorFieldChanged" IsChecked="{Binding RemoteAppEnabled, Mode=TwoWay}"
                                  SemanticProperties.Description="Подключение RemoteApp" />
                        <Label Text="Подключение RemoteApp" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding RemoteAppEnabled}" Spacing="6">
                        <Label Text="Путь к приложению" Style="{StaticResource FieldTitle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Image WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding HasProfileRemoteAppIcon}" Value="False">
                                        <Setter Property="Source" Value="{AppThemeBinding Light={winui:InterfaceImage Name=remote_app_card}, Dark={winui:InterfaceImage Name=remote_app_card_dark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image" Binding="{Binding HasProfileRemoteAppIcon}" Value="True">
                                        <Setter Property="Source" Value="{Binding ProfileRemoteAppIcon}" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Entry Grid.Column="1" x:Name="RemoteAppPathEntry" TextChanged="OnEditorFieldChanged"
                                   Text="{Binding RemoteAppProgram}" Placeholder="Путь к .exe или ||Имя" SemanticProperties.Description="Путь к приложению" />
                            <ImageButton Grid.Column="2" Style="{StaticResource PathButton}" IsVisible="{Binding HasPublishedRemoteApps}"
                                         Source="{AppThemeBinding Light={winui:InterfaceImage Name=remote_app_dropdown_light}, Dark={winui:InterfaceImage Name=remote_app_dropdown_dark}}"
                                         Clicked="OnShowPublishedAppsClicked" ToolTipProperties.Text="Выбрать приложение из списка"
                                         SemanticProperties.Description="Выбрать приложение из списка" />
                            <ImageButton Grid.Column="3" Style="{StaticResource PathButton}" Command="{Binding LoadPublishedRemoteAppsCommand}"
                                         Source="{AppThemeBinding Light={winui:InterfaceImage Name=remote_app_refresh_light}, Dark={winui:InterfaceImage Name=remote_app_refresh_dark}}"
                                         ToolTipProperties.Text="Получить опубликованные приложения"
                                         SemanticProperties.Description="Получить опубликованные приложения" />
                        </Grid>
                        <Label Text="{Binding RemoteAppFeedStatus}">
                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding RemoteAppFeedStatus}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger></Label.Triggers>
                        </Label>
                        <Label Text="Аргументы командной строки" Style="{StaticResource FieldTitle}" />
                        <Entry TextChanged="OnEditorFieldChanged" Text="{Binding RemoteApp.Arguments}" SemanticProperties.Description="Аргументы командной строки" />
                        <Label Text="Рабочая папка на сервере" Style="{StaticResource FieldTitle}" />
                        <Entry TextChanged="OnEditorFieldChanged" Text="{Binding RemoteApp.WorkingDirectory}" SemanticProperties.Description="Рабочая папка на сервере" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Margin="0,8,0,0" Color="{AppThemeBinding Light=#CFDDF1, Dark=#35455E}" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox IsChecked="{Binding RemoteAppUseRdWeb, Mode=TwoWay}" SemanticProperties.Description="RD Web" />
                        <Label Text="RD Web" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding RemoteAppUseRdWeb}" Spacing="6">
                        <Label Text="Адрес ленты RD Web" Style="{StaticResource FieldTitle}" />
                        <Entry TextChanged="OnEditorFieldChanged" Text="{Binding RemoteAppFeedAddress}" Placeholder="https://server.example.com/RDWeb/Feed/webfeed.aspx"
                               SemanticProperties.Description="Адрес ленты RD Web" />
                        <Label Text="Если адрес не указан, используется сервер из раздела «Общие»." FontSize="12"
                               TextColor="{AppThemeBinding Light=#344763, Dark=#AAC2E2}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowGateway}" Spacing="6">
                    <Label Text="Шлюз RD" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Использование шлюза" Style="{StaticResource FieldTitle}" />
                    <Picker ItemsSource="{Binding GatewayUsageMethods}" SelectedIndex="{Binding GatewayUsageMethod, Mode=TwoWay}"
                            SemanticProperties.Description="Использование шлюза" />
                    <VerticalStackLayout IsVisible="{Binding ShowGatewayFields}" Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding GatewayUseExplicitProfile, Mode=TwoWay}"
                                      SemanticProperties.Description="Использовать параметры шлюза из карточки" />
                            <Label Text="Использовать параметры шлюза из карточки" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Адрес шлюза" Style="{StaticResource FieldTitle}" />
                        <Entry Text="{Binding GatewayHostName, Mode=TwoWay}" Placeholder="rdgateway.example.com"
                               SemanticProperties.Description="Адрес шлюза" />
                        <Label Text="Способ входа на шлюз" Style="{StaticResource FieldTitle}" />
                        <Picker ItemsSource="{Binding GatewayCredentialSources}" SelectedIndex="{Binding GatewayCredentialSource, Mode=TwoWay}"
                                SemanticProperties.Description="Способ входа на шлюз" />
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding GatewayShareCredentials, Mode=TwoWay}"
                                      SemanticProperties.Description="Одна учётная запись для шлюза и сервера" />
                            <Label Text="Одна учётная запись для шлюза и сервера" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light=#EAF0FA, Dark=#182234}">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#CFDDF1, Dark=#35455E}" />
                    <Grid Grid.Row="1" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Status}" VerticalOptions="Center"
                               MaxLines="1" LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding Status}">
                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding Status}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger></Label.Triggers>
                        </Label>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                            <Button Text="Сохранить" Clicked="OnSaveClicked" IsEnabled="{Binding CanSaveProfile}"
                                    BackgroundColor="{AppThemeBinding Light=#2459A0, Dark=#376AAD}" TextColor="White" />
                            <Button Text="OK" Clicked="OnCloseClicked"
                                    BackgroundColor="{AppThemeBinding Light=#DFE9F7, Dark=#263750}"
                                    TextColor="{AppThemeBinding Light=#192C49, Dark=#E7EFFC}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
