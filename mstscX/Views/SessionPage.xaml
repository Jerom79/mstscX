<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:loc="clr-namespace:mstscX.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:winui="clr-namespace:mstscX.WinUI"
             xmlns:vm="clr-namespace:mstscX.ViewModels"
             x:DataType="vm:SessionViewModel"
             x:Class="mstscX.Views.SessionPage">
    <ContentView.Resources>
        <Style x:Key="SessionBarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#202020, Dark=White}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8E8E8, Dark=#303030}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DFDFDF, Dark=#373737}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="ConnectionBar" HeightRequest="32" Padding="7,1" ColumnDefinitions="*,2*,*">
            <Label x:Name="ConnectionTitle" Margin="5,0,8,0" FontSize="13" LineBreakMode="TailTruncation"
                   MaxLines="1" VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#202020, Dark=White}" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" HorizontalOptions="Center">
                <Image Source="{winui:InterfaceImage Name=rdp_error}" WidthRequest="16" HeightRequest="16" Margin="0,0,6,0"
                       IsVisible="{Binding IsReconnecting}" />
                <Label Grid.Column="1" Text="{Binding Status}" FontSize="13"
                       MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"
                       ToolTipProperties.Text="{Binding Status}"
                       TextColor="{AppThemeBinding Light=#202020, Dark=White}" />
            </Grid>
            <Grid Grid.Column="2" ColumnDefinitions="*,*" WidthRequest="96" HorizontalOptions="End">
                <Button Style="{StaticResource SessionBarButton}" Text="&#xE740;"
                        ToolTipProperties.Text="{loc:Text Key=S9EA399749884}" SemanticProperties.Description="{loc:Text Key=S9EA399749884}"
                        Clicked="OnToggleFullScreen" IsEnabled="{Binding IsConnected}" />
                <Button Grid.Column="1" Style="{StaticResource SessionBarButton}" Text="&#xE8BB;"
                        ToolTipProperties.Text="{loc:Text Key=S396B1ABE59ED}" SemanticProperties.Description="{loc:Text Key=S396B1ABE59ED}"
                        Clicked="Disconnect" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1" x:Name="SessionArea" BackgroundColor="Black">
            <ScrollView IsVisible="{Binding IsSessionNoticeVisible}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFD, Dark=#141B25}">
                <Grid Padding="24">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center" MaximumWidthRequest="640">
                        <Label x:Name="SessionEndpoint" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               LineBreakMode="CharacterWrap" />
                        <Label Text="{Binding Status}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
