<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:loc="clr-namespace:mstscX.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:mstscX.Models"
             x:Class="mstscX.Views.ServerCardName" x:DataType="models:ServerProfile">
    <Grid>
        <Label x:Name="NameLabel" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center"
               FontSize="14"
               LineBreakMode="TailTruncation">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Entry x:Name="RenameEntry" IsVisible="{Binding IsRenaming}" MinimumHeightRequest="32"
               PropertyChanged="OnRenameEntryPropertyChanged" HandlerChanged="OnRenameEntryHandlerChanged"
               Completed="OnRenameEntryCompleted" SemanticProperties.Description="{loc:Text Key=SD403A806817B}"
               ToolTipProperties.Text="{loc:Text Key=S6480E76F84CC}" />
    </Grid>
</ContentView>
